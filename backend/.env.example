# Copy this file to `.env` and fill in the values you need.
# Everything is optional: without OPENAI_API_KEY the app still works using the
# static analyzers (Ruff, Bandit, Radon); only the AI review is turned off.

# --- AI review (any OpenAI-compatible API) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ---
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reject submissions larger than this many characters.
MAX_CODE_CHARS=50000
